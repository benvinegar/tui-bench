{
  "name": "terminal-ui-bench",
  "version": "0.1.0",
  "private": true,
  "description": "Benchmark LLMs at building terminal UIs in Rust + ratatui and TypeScript + OpenTUI, judged side by side by humans",
  "type": "module",
  "bin": { "tuibench": "./bin/tuibench" },
  "scripts": {
    "tuibench": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "engines": { "node": ">=22" },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@xterm/headless": "^6.0.0",
    "commander": "^14.0.0",
    "node-pty": "^1.1.0",
    "openai": "^7.45.0",
    "yaml": "^2.9.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0"
  }
}
